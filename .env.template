# Comment-Sentiment Environment Configuration
# Copy this file to .env and fill in your values

# Debug mode (set to "true" to enable)
DEBUG=False

# AI Provider: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic API Key (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Output directory for analysis results (defaults to ./output)
OUTPUT_PATH=

# Path to Stanford CoreNLP installation (defaults to ./stanford-corenlp-4.5.7)
STANFORD_CORENLP_PATH=
